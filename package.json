{
  "name": "astro-gyoza",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "prepare": "pnpm exec simple-git-hooks",
    "postinstall": "node scripts/download-fonts.js",
    "dev": "astro dev",
    "build": "astro check && astro build && pagefind --site dist --output-subdir pagefind",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "prettier --write .",
    "new-friend": "node scripts/new-friend.js",
    "new-post": "node scripts/new-post.js",
    "new-project": "node scripts/new-project.js",
    "transform": "node scripts/transform.js"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.5",
    "@astrojs/rss": "^4.0.13",
    "@astrojs/sitemap": "^3.6.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^5.15.8",
    "reading-time": "^1.5.0",
    "satori": "^0.26.0",
    "sharp": "^0.35.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@inquirer/prompts": "^7.10.1",
    "lint-staged": "^16.2.6",
    "pagefind": "^1.5.2",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.3"
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm exec commitlint --edit $1",
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,astro,md,css,json}": "prettier --write"
  },
  "pnpm": {
    "overrides": {
      "baseline-browser-mapping": "2.10.21"
    }
  }
}

---
import type { GetStaticPaths } from 'astro'
import type { CollectionEntry } from 'astro:content'
import { getCollection } from 'astro:content'
import Layout from '@/layouts/Layout.astro'

export const getStaticPaths = (async () => {
  const specList = await getCollection('spec')
  return specList.map((md) => ({
    params: { spec: md.slug },
    props: { md },
  }))
}) satisfies GetStaticPaths

interface Props {
  md: CollectionEntry<'spec'>
}

const { md } = Astro.props
const { Content } = await md.render()

const isFriends = md.slug === 'friends'
const isProjects = md.slug === 'projects'
---

<Layout title={md.data.title} description={md.data.description}>
  {
    isFriends ? (
      <div>
        <h1>{md.data.title}</h1>
        <p>{md.data.description}</p>
        {await (async () => {
          const friends = await getCollection('friends')
          return (
            <ul>
              {friends.map((f) => (
                <li>
                  <a href={f.data.link} rel="noopener noreferrer" target="_blank">
                    {f.data.avatar && (
                      <img
                        src={f.data.avatar}
                        alt={f.data.title}
                        width="40"
                        height="40"
                        loading="lazy"
                      />
                    )}
                    <span>{f.data.title}</span>
                  </a>
                  <p>{f.data.description}</p>
                </li>
              ))}
            </ul>
          )
        })()}
        <Content />
      </div>
    ) : isProjects ? (
      <div>
        <h1>{md.data.title}</h1>
        <p>{md.data.description}</p>
        {await (async () => {
          const projects = await getCollection('projects')
          return (
            <ul>
              {projects.map((p) => (
                <li>
                  <a href={p.data.link} rel="noopener noreferrer" target="_blank">
                    {p.data.image && (
                      <img
                        src={p.data.image}
                        alt={p.data.title}
                        width="200"
                        height="120"
                        loading="lazy"
                      />
                    )}
                    <span>{p.data.title}</span>
                  </a>
                  <p>{p.data.description}</p>
                </li>
              ))}
            </ul>
          )
        })()}
        <Content />
      </div>
    ) : (
      <article>
        <h1>{md.data.title}</h1>
        <Content />
      </article>
    )
  }
</Layout>

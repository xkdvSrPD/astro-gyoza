---
import type { GetStaticPaths } from 'astro'
import type { CollectionEntry } from 'astro:content'
import { getCollection } from 'astro:content'
import MarkdownLayout from '@/layouts/MarkdownLayout.astro'
import PageLayout from '@/layouts/PageLayout.astro'
import Highlight from '@/components/Highlight.astro'
import SectionBlock from '@/components/SectionBlock.astro'
import MarkdownWrapper from '@/components/MarkdownWrapper.astro'
import FriendList from '@/components/FriendList.astro'
import ProjectList from '@/components/ProjectList.astro'
import { ReadingProgress } from '@/components/post/ReadingProgress'
import { PostToc } from '@/components/post/PostToc'
import { Comments } from '@/components/comment'

export const getStaticPaths = (async () => {
  const specList = await getCollection('spec')

  return specList.map((md) => ({
    params: { spec: md.slug },
    props: {
      md,
    },
  }))
}) satisfies GetStaticPaths

interface Props {
  md: CollectionEntry<'spec'>
}

const { md } = Astro.props

const { headings, Content } = await md.render()

const isPageLayout = ['friends', 'projects'].includes(md.slug)
const isAboutPage = md.slug === 'about'
const mdBody = md.body ?? ''
const isMdContentEmpty = mdBody.trim().length === 0
---

{
  isPageLayout ? (
    <PageLayout title={md.data.title} description={md.data.description}>
      <div class="swup-transition-fade">
        <div class="max-w-[800px] mx-auto px-4 py-16 space-y-8" data-pagefind-body>
          <header class="space-y-4">
            <h1 class="text-4xl font-bold">
              <Highlight>{md.data.title}</Highlight>
            </h1>
            <p>{md.data.description}</p>
          </header>
          {md.slug === 'friends' && <FriendList />}
          {md.slug === 'projects' && <ProjectList />}
          {!isMdContentEmpty && (
            <MarkdownWrapper>
              <Content />
            </MarkdownWrapper>
          )}
          {md.data.comments && <Comments />}
        </div>
      </div>
    </PageLayout>
  ) : (
    <MarkdownLayout
      title={md.data.title}
      description={md.data.description}
      mdTitle={md.data.title}
      mdDescription={md.data.description}
      mdSlug={md.slug}
    >
      {isAboutPage ? (
        <div class="swup-transition-fade">
          <div
            class="w-full max-w-full lg:max-w-[800px] mx-auto px-4 py-16 space-y-10"
            data-pagefind-body
          >
            <header class="space-y-4 text-left">
              <h1 class="text-4xl font-bold">
                <Highlight>{md.data.title}</Highlight>
              </h1>
              <p>{md.data.description}</p>
            </header>
            <div class="text-left">
              <MarkdownWrapper>
                <Content />
              </MarkdownWrapper>
            </div>
          </div>
          {md.data.comments && (
            <div class="w-full max-w-full lg:max-w-[800px] mx-auto px-4 pb-16">
              <Comments />
            </div>
          )}
        </div>
      ) : (
        <div class="w-full max-w-full lg:max-w-[1100px] mx-auto px-4 md:px-8 py-16">
          <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_260px] gap-8">
            <!-- Main content with swup transition -->
            <div class="swup-transition-fade" data-pagefind-body>
              <header class="space-y-4">
                <h1 class="text-4xl font-bold">
                  <Highlight>{md.data.title}</Highlight>
                </h1>
                <p>{md.data.description}</p>
              </header>

              <div class="mt-8">
                <MarkdownWrapper>
                  <Content />
                </MarkdownWrapper>
              </div>

              {md.data.comments && (
                <div class="mt-12">
                  <Comments />
                </div>
              )}
            </div>

            <!-- Sticky sidebar - outside swup transition -->
            <div class="hidden lg:block" data-pagefind-ignore>
              <aside class="sticky top-20">
                <SectionBlock title="目录">
                  <PostToc headings={headings} client:idle />
                  <hr class="my-2 border-primary max-w-[100px]" />
                  <ReadingProgress client:idle />
                </SectionBlock>
              </aside>
            </div>
          </div>
        </div>
      )}
    </MarkdownLayout>
  )
}

---
import type { CollectionEntry } from 'astro:content'
import type { GetStaticPaths } from 'astro'
import Layout from '@/layouts/Layout.astro'
import { getSortedPosts } from '@/utils/content'
import { generatePostOgImage } from '@/utils/ogImage'
import { getFormattedDateTime } from '@/utils/date'
import { taxonomyHref } from '@/utils/taxonomy'
import { Comments } from '@/components/comment'

export const getStaticPaths = (async () => {
  const sortedPosts = await getSortedPosts()
  return sortedPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }))
}) satisfies GetStaticPaths

interface Props {
  post: CollectionEntry<'posts'>
}

const { post } = Astro.props
const { Content } = await post.render()
const ogImage = await generatePostOgImage(post)
---

<Layout title={post.data.title} description={post.data.summary} image={ogImage}>
  <article class="content-body">
    <header class="article-header">
      <h1 class="article-title">{post.data.title}</h1>
      <table class="commit-info">
        <tbody>
          <tr>
            <th>created</th>
            <td>
              <time datetime={post.data.createAt.toISOString()}>
                {getFormattedDateTime(post.data.createAt)}
              </time>
            </td>
          </tr>
          {
            post.data.updateAt && post.data.updateAt > post.data.createAt && (
              <tr>
                <th>updated</th>
                <td>
                  <time datetime={post.data.updateAt.toISOString()}>
                    {getFormattedDateTime(post.data.updateAt)}
                  </time>
                </td>
              </tr>
            )
          }
          {
            post.data.category && (
              <tr>
                <th>category</th>
                <td>
                  <a href={taxonomyHref('category', post.data.category)}>
                    <span class="sr-only">Category: </span>
                    {post.data.category}
                  </a>
                </td>
              </tr>
            )
          }
          {
            post.data.tags.length > 0 && (
              <tr>
                <th>tags</th>
                <td>
                  {post.data.tags.map((tag, i) => (
                    <>
                      {i > 0 && '、'}
                      <a href={taxonomyHref('tag', tag)}>
                        <span class="sr-only">Tag: </span>
                        {tag}
                      </a>
                    </>
                  ))}
                </td>
              </tr>
            )
          }
        </tbody>
      </table>
    </header>
    <div>
      <Content />
    </div>
    {post.data.comments !== false && <Comments />}
  </article>
</Layout>

---
import type { CollectionEntry } from 'astro:content'
import type { GetStaticPaths } from 'astro'
import Layout from '@/layouts/Layout.astro'
import { getSortedPosts } from '@/utils/content'
import { getFormattedDateTime } from '@/utils/date'

export const getStaticPaths = (async () => {
  const sortedPosts = await getSortedPosts()
  return sortedPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }))
}) satisfies GetStaticPaths

interface Props {
  post: CollectionEntry<'posts'>
}

const { post } = Astro.props
const { Content } = await post.render()
---

<Layout title={post.data.title} description={post.data.summary}>
  <article>
    <header>
      <h1>{post.data.title}</h1>
      <time datetime={post.data.createAt.toISOString()}>
        {getFormattedDateTime(post.data.createAt)}
      </time>
      {
        post.data.updateAt && post.data.updateAt > post.data.createAt && (
          <span> (更新于 {getFormattedDateTime(post.data.updateAt)})</span>
        )
      }
      {post.data.category && <p>分类: {post.data.category}</p>}
      {post.data.tags.length > 0 && <p>标签: {post.data.tags.join(', ')}</p>}
    </header>
    <div>
      <Content />
    </div>
  </article>
</Layout>

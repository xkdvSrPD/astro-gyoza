---
import Layout from '@/layouts/Layout.astro'
import PostTable from '@/components/PostTable.astro'
import { getOldestPosts } from '@/utils/content'

const posts = await getOldestPosts()
---

<Layout title="Summary">
  <h1>Summary</h1>
  <p class="page-note">共 {posts.length} 篇文章</p>
  <PostTable posts={posts} />
</Layout>

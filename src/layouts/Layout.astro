---
import '@/styles/global.css'
import { author, site } from '@/config.json'

interface Props {
  title?: string
  description?: string
  image?: string
}

const { title, description, image } = Astro.props

const pageTitle = title ? `${title} - ${site.title}` : site.title
const pathname = Astro.url.pathname
const avatar = author.avatar || '/favicon.ico'
const siteUrl = Astro.site?.toString() || site.url
const ogImageUrl = image
  ? new URL(image, siteUrl).toString()
  : new URL('/apple-touch-icon.png', siteUrl).toString()

const isActive = (href: string) => {
  if (href === '/') {
    return pathname === '/'
  }
  return pathname === href || pathname.startsWith(`${href}/`)
}

const summaryActive = isActive('/')
const archivesActive = isActive('/archives') || isActive('/tag') || isActive('/category')
const friendsActive = isActive('/friends')
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description || site.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description || site.description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={pageTitle} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={site.lang} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description || site.description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={pageTitle} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>
      ;(() => {
        const storedTheme = localStorage.getItem('site-theme')
        const theme =
          storedTheme ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'black' : 'white')
        const defaultWidth =
          window.innerWidth < 768 ? '100' : window.innerWidth < 1200 ? '80' : '60'
        const width = localStorage.getItem('site-width') || defaultWidth
        document.documentElement.dataset.theme = theme
        document.documentElement.dataset.width = width
      })()
    </script>
  </head>
  <body>
    <div id="cgit" class="site-frame">
      <header class="site-header" data-pagefind-ignore>
        <table id="header">
          <tbody>
            <tr>
              <td class="logo" rowspan="2">
                <a class="site-avatar" href="/" aria-label={site.title}>
                  <img src={avatar} alt={author.name} width="96" height="96" loading="eager" />
                </a>
              </td>
              <td class="main">
                <a href="/" data-scramble>{site.title}</a>
              </td>
              <td class="form" rowspan="2">
                <div class="site-tools" aria-label="站点工具">
                  <form class="site-search" role="search">
                    <label class="sr-only" for="site-search-input">Search</label>
                    <input
                      id="site-search-input"
                      type="search"
                      name="q"
                      placeholder='grep -r "keywords" .'
                      autocomplete="off"
                    />
                    <div id="site-search-results" class="search-results" hidden></div>
                  </form>
                  <div class="tool-row" aria-label="主题切换">
                    <span>theme:</span>
                    <button type="button" data-theme-choice="white">white</button>
                    <button type="button" data-theme-choice="black">black</button>
                    <button type="button" data-theme-choice="purple">purple</button>
                    <button type="button" data-theme-choice="blue">blue</button>
                  </div>
                  <div class="tool-row" aria-label="页面宽度">
                    <span>width:</span>
                    <button type="button" data-width-choice="100">100</button>
                    <button type="button" data-width-choice="80">80</button>
                    <button type="button" data-width-choice="60">60</button>
                    <button type="button" data-width-choice="40">40</button>
                  </div>
                </div>
              </td>
            </tr>
            <tr>
              <td class="sub" id="site-desc" data-typewriter data-text={site.description}>
                {site.description}
              </td>
            </tr>
          </tbody>
        </table>
        <table class="tabs">
          <tbody>
            <tr>
              <td>
                <nav aria-label="主导航">
                  <a
                    href="/"
                    data-scramble
                    class={summaryActive ? 'active' : undefined}
                    aria-current={summaryActive ? 'page' : undefined}>about</a
                  >
                  <a
                    href="/archives"
                    data-scramble
                    class={archivesActive ? 'active' : undefined}
                    aria-current={archivesActive ? 'page' : undefined}>summary</a
                  >
                  <a
                    href="/friends"
                    data-scramble
                    class={friendsActive ? 'active' : undefined}
                    aria-current={friendsActive ? 'page' : undefined}>ref</a
                  >
                </nav>
              </td>
            </tr>
          </tbody>
        </table>
      </header>
      <main class="content" data-pagefind-body data-reveal-root>
        <slot />
      </main>
      <footer class="footer" data-pagefind-ignore>
        <p>&copy; {new Date().getFullYear()} {site.title}</p>
        <p id="beian" style="display:none">
          <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener"></a>
        </p>
      </footer>
    </div>
    <script is:inline type="module" src="/site.js"></script>
    <script is:inline type="module" src="/terminal.js"></script>
  </body>
</html>

<div
  id="site-animated-background-root"
  aria-hidden="true"
  class="pointer-events-none fixed inset-0 z-0 overflow-hidden"
  style="background-color: rgb(var(--color-bg-root));"
>
  <div
    class="absolute inset-0 opacity-70"
    style="
      background-image:
        radial-gradient(circle at 12% 20%, rgb(var(--color-accent) / 0.12) 0%, transparent 52%),
        radial-gradient(circle at 80% 0%, rgb(var(--color-text-secondary) / 0.08) 0%, transparent 58%),
        radial-gradient(circle at 52% 100%, rgb(var(--color-bg-primary) / 0.5) 0%, transparent 72%);
    "
  >
  </div>
  <div
    class="absolute inset-0 opacity-60 blur-[96px]"
    style="
      background-image:
        radial-gradient(circle at 20% 30%, rgb(var(--color-accent) / 0.16) 0%, transparent 38%),
        radial-gradient(circle at 76% 12%, rgb(var(--color-border-primary) / 0.14) 0%, transparent 44%);
    "
  >
  </div>
</div>

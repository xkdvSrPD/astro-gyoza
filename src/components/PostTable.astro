---
import type { CollectionEntry } from 'astro:content'
import { getFormattedDate } from '@/utils/date'
import { taxonomyHref } from '@/utils/taxonomy'

interface Props {
  posts: CollectionEntry<'posts'>[]
}

const { posts } = Astro.props
---

<div class="post-table">
  <table class="list list-table">
    <thead>
      <tr class="logheader">
        <th>Title</th>
        <th>Tags</th>
        <th class="list-category">Category</th>
        <th class="list-date">Date</th>
      </tr>
    </thead>
    <tbody>
      {
        posts.map((post) => (
          <tr>
            <td class="list-title">
              <a href={`/posts/${post.slug}`}>{post.data.title}</a>
            </td>
            <td class="list-category">
              {post.data.tags.length > 0 ? (
                post.data.tags.map((tag, i) => (
                  <>
                    {i > 0 && '、'}
                    <a href={taxonomyHref('tag', tag)}>{tag}</a>
                  </>
                ))
              ) : (
                <span class="muted">-</span>
              )}
            </td>
            <td class="list-category">
              {post.data.category ? (
                <a href={taxonomyHref('category', post.data.category)}>{post.data.category}</a>
              ) : (
                <span class="muted">-</span>
              )}
            </td>
            <td class="list-date">
              <time datetime={post.data.createAt.toISOString()}>
                {getFormattedDate(post.data.createAt)}
              </time>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

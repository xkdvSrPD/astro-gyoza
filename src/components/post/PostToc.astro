---
import type { MarkdownHeading } from 'astro'

interface Props {
  headings: MarkdownHeading[]
}

const { headings } = Astro.props
---

<nav aria-label="Table of contents" data-post-toc>
  <ul
    class="group relative space-y-2 overflow-y-auto text-sm"
    style={{
      maxHeight: 'min(380px, calc(100vh - 250px))',
      scrollbarWidth: 'none',
    }}
    data-post-toc-scroll
  >
    {
      headings.map((heading) => (
        <li class="relative" data-toc-item data-heading-slug={heading.slug}>
          <span
            class="absolute left-0 top-2 h-1 rounded-full bg-zinc-300 transition-colors dark:bg-zinc-700"
            style={{ width: `${4 * (7 - heading.depth)}px` }}
            aria-hidden="true"
            data-toc-indicator
          />
          <a
            class="inline-block pl-8 opacity-0 text-zinc-500 transition-opacity duration-300 group-hover:opacity-100 hover:text-zinc-900 dark:hover:text-zinc-100"
            href={`#${heading.slug}`}
            data-toc-link
          >
            {heading.text}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

---
import { getFormattedDate } from '@/utils/date'

interface Props {
  lastMod: Date
}

const { lastMod } = Astro.props
---

<div
  class="hidden rounded-lg border border-amber-300 bg-amber-300/10 p-4 text-sm"
  data-outdate
  data-last-mod={lastMod.toISOString()}
>
  <span>
    This article was published on {getFormattedDate(lastMod)}. Some details may be outdated.
  </span>
</div>

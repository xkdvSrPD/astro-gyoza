---
import { site } from '@/config.json'

interface Props {
  title: string
  slug: string
}

const { title, slug } = Astro.props
const url = new URL(slug, site.url).href
---

<div
  class="absolute bottom-0 left-0 flex flex-col gap-4"
  style={{
    transform: 'translateY(calc(100% + 24px))',
  }}
  data-share-root
  data-share-url={url}
  data-share-title={title}
>
  <button
    type="button"
    aria-label="Share this post"
    class="size-6 text-xl leading-none hover:text-accent"
    data-share-open
  >
    <i class="iconfont icon-share"></i>
  </button>

  <div class="hidden" aria-hidden="true" data-share-modal>
    <div
      class="fixed inset-0 z-[70] flex items-center justify-center bg-zinc-950/35 px-4 backdrop-blur-sm"
    >
      <div class="absolute inset-0" data-share-close></div>
      <div
        class="relative w-[min(420px,100%)] rounded-2xl border border-primary bg-primary p-4 shadow-2xl shadow-zinc-900/10"
        role="dialog"
        aria-modal="true"
        aria-label="Share"
      >
        <div class="flex items-start justify-between gap-4">
          <div class="min-w-0">
            <h2 class="font-semibold">Share this post</h2>
            <p class="mt-1 text-sm text-secondary">{title || 'Post link and QR code'}</p>
          </div>
          <button
            class="rounded-full px-2 py-1 text-xs text-secondary transition-colors hover:bg-secondary hover:text-primary"
            type="button"
            data-share-close
          >
            Esc
          </button>
        </div>
        <div class="mt-4 grid gap-4 sm:grid-cols-[180px_minmax(0,1fr)]">
          <div
            class="flex h-[180px] items-center justify-center rounded-2xl border border-primary bg-white p-3"
          >
            <img
              class="hidden size-[156px]"
              alt="Share QR code"
              width="156"
              height="156"
              decoding="async"
              data-share-qr-image
            />
            <span class="text-sm text-secondary" data-share-qr-loading>Loading QR code...</span>
          </div>
          <div class="flex min-w-0 flex-col gap-3">
            <div
              class="break-all rounded-2xl border border-primary bg-secondary/50 p-3 text-sm text-secondary"
            >
              {url}
            </div>
            <button
              type="button"
              class="rounded-2xl border border-primary px-4 py-2 text-sm transition-colors hover:bg-secondary"
              data-copy-text={url}
              data-copy-success="Link copied"
              data-copy-error="Copy failed"
            >
              Copy link
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

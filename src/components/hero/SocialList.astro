---
import clsx from 'clsx'
import { hero } from '@/config.json'

interface Props {
  className?: string
}

const { className } = Astro.props
---

<ul class={clsx('flex gap-4 flex-wrap items-center justify-center lg:justify-start', className)}>
  {
    hero.socials.map((social) => (
      <li>
        <a
          class="relative flex size-9 items-center justify-center rounded-full text-xl text-white transition-transform duration-150 hover:-translate-y-0.5"
          href={social.url}
          title={social.name}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span
            class="absolute inset-0 -z-1 rounded-full transition-opacity duration-150"
            style={`background-color: ${social.color}; opacity: 0.94;`}
          />
          <i class:list={['iconfont', social.icon]} />
        </a>
      </li>
    ))
  }
</ul>

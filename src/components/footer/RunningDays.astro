---
import { footer } from '@/config.json'
---

<span data-running-days data-start-time={footer.startTime}></span>

<script>
  const runningDaysWindow = window as Window & {
    __runningDaysInitialized?: boolean
  }

  if (!runningDaysWindow.__runningDaysInitialized) {
    runningDaysWindow.__runningDaysInitialized = true

    const instances = Array.from(document.querySelectorAll<HTMLElement>('[data-running-days]'))

    const renderDays = () => {
      instances.forEach((element) => {
        const startTime = element.dataset.startTime
        if (!startTime) {
          return
        }

        const startDate = new Date(startTime)
        const diffMs = Date.now() - startDate.getTime()
        const days = Math.floor(diffMs / 86400000)

        element.textContent =
          days < 0 ? 'Site is not live yet.' : `Running for ${days} day${days === 1 ? '' : 's'}`
      })
    }

    renderDays()
  }
</script>

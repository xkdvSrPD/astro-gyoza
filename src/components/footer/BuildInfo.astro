---
import { getFormattedDateTime, getRelativeTime } from '@/utils/date'
import { getBuildInfo } from '@/utils/buildInfo'

const buildInfo = getBuildInfo()
const buildDate = new Date(buildInfo.buildTime)
const relativeTime = getRelativeTime(buildDate)
const displayTime = relativeTime
  ? `已构建 ${relativeTime}`
  : `构建于 ${getFormattedDateTime(buildDate)}`
---

<span>
  <code class="rounded bg-primary/10 px-1.5 py-0.5 text-xs font-mono">{buildInfo.gitHash}</code>
  <span class="mx-1 select-none opacity-50">|</span>
  {displayTime}
</span>

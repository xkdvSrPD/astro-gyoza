<div class="relative inline-block" data-theme-switch>
  <div
    class="absolute -z-1 top-1 size-[32px] rounded-full bg-primary shadow transition-transform"
    data-theme-thumb
  >
  </div>
  <div class="flex rounded-full border border-primary p-[3px]" role="radiogroup">
    <button
      class="flex size-[32px] items-center justify-center"
      type="button"
      aria-label="Switch to light theme"
      data-theme-mode="light"
      data-theme-button
    >
      <i class="iconfont icon-sun"></i>
    </button>
    <button
      class="flex size-[32px] items-center justify-center"
      type="button"
      aria-label="Switch to system theme"
      data-theme-mode="system"
      data-theme-button
    >
      <i class="iconfont icon-computer"></i>
    </button>
    <button
      class="flex size-[32px] items-center justify-center"
      type="button"
      aria-label="Switch to dark theme"
      data-theme-mode="dark"
      data-theme-button
    >
      <i class="iconfont icon-moon"></i>
    </button>
  </div>
</div>

<script>
  import {
    changePageTheme,
    getLocalTheme,
    getSystemTheme,
    setLocalTheme,
    type ThemeMode,
  } from '@/utils/theme'

  const themeSwitchWindow = window as Window & {
    __themeSwitchInitialized?: boolean
  }

  if (!themeSwitchWindow.__themeSwitchInitialized) {
    themeSwitchWindow.__themeSwitchInitialized = true

    const root = document.querySelector<HTMLElement>('[data-theme-switch]')
    const thumb = root?.querySelector<HTMLElement>('[data-theme-thumb]')
    const buttons = Array.from(
      root?.querySelectorAll<HTMLButtonElement>('[data-theme-button]') ?? [],
    )
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)')

    const positions: Record<ThemeMode, number> = {
      light: 4,
      system: 36,
      dark: 68,
    }

    const syncTheme = () => {
      const mode = getLocalTheme()
      const appliedTheme = mode === 'system' ? getSystemTheme() : mode

      changePageTheme(appliedTheme)

      if (thumb) {
        thumb.style.transform = `translateX(${positions[mode]}px)`
      }

      buttons.forEach((button) => {
        const isActive = button.dataset.themeMode === mode
        button.setAttribute('aria-checked', String(isActive))
        button.classList.toggle('text-accent', isActive)
      })

      document.dispatchEvent(
        new CustomEvent('app-theme-change', {
          detail: {
            mode,
            theme: appliedTheme,
          },
        }),
      )
    }

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const nextMode = button.dataset.themeMode as ThemeMode | undefined
        if (!nextMode) {
          return
        }

        setLocalTheme(nextMode)
        syncTheme()
      })
    })

    prefersDark.addEventListener('change', () => {
      if (getLocalTheme() === 'system') {
        syncTheme()
      }
    })

    syncTheme()
  }
</script>

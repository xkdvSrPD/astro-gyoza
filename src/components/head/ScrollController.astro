<!-- 路由切换滚动控制器 -->
<script>
  const HEADER_HEIGHT_DEFAULT = 64
  const EXTRA_SCROLL_GAP = 16

  if (window.location.hash) {
    window.scrollTo(0, 0)
  }

  function getCssHeaderHeight() {
    const root = document.documentElement
    const value = getComputedStyle(root).getPropertyValue('--header-height')
    const parsed = parseFloat(value)
    return Number.isFinite(parsed) ? parsed : HEADER_HEIGHT_DEFAULT
  }

  let currentHeaderOffset = HEADER_HEIGHT_DEFAULT + EXTRA_SCROLL_GAP

  function updateHeaderOffset() {
    const header = document.querySelector('[data-site-header]')
    const headerHeight =
      header instanceof HTMLElement ? header.getBoundingClientRect().height : getCssHeaderHeight()
    currentHeaderOffset = headerHeight + EXTRA_SCROLL_GAP
    const root = document.documentElement
    root.style.setProperty('--header-height', `${headerHeight}px`)
    root.style.setProperty('--header-offset', `${currentHeaderOffset}px`)
  }

  function getTargetFromHash(hash: string | null) {
    if (!hash) return null
    const normalized = hash.startsWith('#') ? hash.slice(1) : hash
    if (!normalized) return null

    let decoded = normalized
    try {
      decoded = decodeURIComponent(normalized)
    } catch (error) {
      // ignore decode errors and fall back to original value
    }

    return document.getElementById(decoded) ?? (decoded !== normalized ? document.getElementById(normalized) : null)
  }

  function scrollToTarget(target: HTMLElement, smooth = true) {
    const destination =
      target.getBoundingClientRect().top + window.scrollY - Math.max(currentHeaderOffset, 0)

    window.scrollTo({
      top: Math.max(destination, 0),
      behavior: smooth ? 'smooth' : 'auto',
    })
  }

  function handleAnchorNavigation(hash: string, smooth = true) {
    const target = getTargetFromHash(hash)
    if (!target) return false
    scrollToTarget(target, smooth)
    return true
  }

  function handleAnchorClick(event: Event) {
    if (!event.target) return

    const target = (event.target as Element).closest('a')
    if (!target) return

    const href = target.getAttribute('href')
    if (!href || !href.startsWith('#')) return

    event.preventDefault()
    if (handleAnchorNavigation(href, true)) {
      history.pushState(null, '', href)
    }
  }

  function handleHashOnLoad() {
    const { hash } = window.location
    if (!hash) return
    requestAnimationFrame(() => {
      handleAnchorNavigation(hash, false)
    })
  }

  function handleRouteChange() {
    // 路由切换时立即滚动到顶部，无动画
    window.scrollTo(0, 0)
    handleHashOnLoad()
  }

  function initScrollHandlers() {
    updateHeaderOffset()
    handleRouteChange()
  }

  window.addEventListener(
    'resize',
    () => {
      updateHeaderOffset()
    },
    { passive: true },
  )

  // 监听swup路由切换事件
  document.addEventListener('swup:content:replace', () => {
    updateHeaderOffset()
    handleRouteChange()
  })

  // 监听锚点点击事件
  document.addEventListener('click', handleAnchorClick)

  // 页面加载完毕后执行初始化，确保锚点元素已渲染
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initScrollHandlers, { once: true })
  } else {
    initScrollHandlers()
  }
</script>

<!-- Code Copy Handler - Manages code block copy functionality -->
<script>
  let initialized = false

  function copyCodeToClipboard(code: string, button: HTMLElement) {
    navigator.clipboard
      .writeText(code)
      .then(() => {
        triggerSuccessFeedback(button)
      })
      .catch(() => {
        showToast('复制失败！')
      })
  }

  function triggerSuccessFeedback(button: HTMLElement) {
    button.classList.add('copy-code-btn--copied')

    const baseShadow = 'rgb(var(--color-accent) / 0.25)'
    const intenseShadow = 'rgb(var(--color-accent) / 0.4)'

    button.animate(
      [
        {
          transform: 'scale(1) translateY(-1px)',
          boxShadow: `0 4px 12px ${baseShadow}`,
        },
        {
          transform: 'scale(1.08) translateY(-2px)',
          boxShadow: `0 8px 24px ${intenseShadow}`,
        },
        {
          transform: 'scale(1) translateY(-1px)',
          boxShadow: `0 4px 16px ${baseShadow}`,
        },
      ],
      {
        duration: 400,
        easing: 'cubic-bezier(0.34, 1.56, 0.64, 1)',
      },
    )

    setTimeout(() => {
      button.classList.remove('copy-code-btn--copied')
    }, 1800)
  }

  function showToast(message: string) {
    const event = new CustomEvent('code-copy-fail', {
      detail: { message },
    })
    window.dispatchEvent(event)
  }

  function getCopyButton(target: EventTarget | null): HTMLElement | null {
    if (!(target instanceof HTMLElement)) return null
    if (target.classList.contains('copy-code-btn')) return target
    return target.closest('.copy-code-btn')
  }

  function handleCopyClick(event: MouseEvent) {
    const button = getCopyButton(event.target)
    if (!button) return

    event.preventDefault()

    const codeBlock = button.closest('.code-block')
    const codeElement = codeBlock?.querySelector('pre code')
    if (!codeElement) return

    const code = codeElement.textContent || ''
    copyCodeToClipboard(code, button)
  }

  function initialize() {
    if (initialized) return
    initialized = true
    document.addEventListener('click', handleCopyClick)
  }

  initialize()
</script>

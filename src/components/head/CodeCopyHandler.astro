<!-- Code Copy Handler - Manages code block copy functionality -->
<script>
  let initialized = false
  let resizeTimer: number | undefined

  function copyCodeToClipboard(code: string, button: HTMLElement) {
    navigator.clipboard
      .writeText(code)
      .then(() => {
        triggerSuccessFeedback(button)
      })
      .catch(() => {
        showToast('复制失败！')
      })
  }

  function triggerSuccessFeedback(button: HTMLElement) {
    button.classList.add('copy-code-btn--copied')

    setTimeout(() => {
      button.classList.remove('copy-code-btn--copied')
    }, 1800)
  }

  function showToast(message: string) {
    const event = new CustomEvent('code-copy-fail', {
      detail: { message },
    })
    window.dispatchEvent(event)
  }

  function getCopyButton(target: EventTarget | null): HTMLElement | null {
    if (!(target instanceof HTMLElement)) return null
    if (target.classList.contains('copy-code-btn')) return target
    return target.closest('.copy-code-btn')
  }

  function handleCopyClick(event: MouseEvent) {
    const button = getCopyButton(event.target)
    if (!button) return

    event.preventDefault()

    const codeBlock = button.closest('.code-block')
    const codeElement = codeBlock?.querySelector('pre code')
    if (!codeElement) return

    const code = codeElement.textContent || ''
    copyCodeToClipboard(code, button)
  }

  function updateCodeBlockToggleState() {
    const blocks = document.querySelectorAll<HTMLElement>('.code-block')

    blocks.forEach((block) => {
      const pre = block.querySelector<HTMLElement>('pre')
      if (!pre) return

      let toggleButton = block.querySelector<HTMLButtonElement>('.toggle-code-btn')
      if (!toggleButton) {
        toggleButton = document.createElement('button')
        toggleButton.className = 'toggle-code-btn'
        toggleButton.type = 'button'
        toggleButton.setAttribute('aria-expanded', 'false')
        toggleButton.setAttribute('aria-label', '展开代码')
        toggleButton.title = '展开代码'

        const arrow = document.createElement('span')
        arrow.className = 'toggle-code-btn__arrow'
        arrow.setAttribute('aria-hidden', 'true')
        arrow.textContent = '⌄'

        toggleButton.appendChild(arrow)
        block.appendChild(toggleButton)
      }

      const isOverflowing = pre.scrollHeight > pre.clientHeight + 1
      const shouldCollapse = isOverflowing || block.classList.contains('code-block--expanded')

      block.classList.toggle('code-block--collapsible', shouldCollapse)
      if (!isOverflowing && !block.classList.contains('code-block--expanded')) {
        block.classList.remove('code-block--expanded')
      }
    })
  }

  function getToggleButton(target: EventTarget | null): HTMLElement | null {
    if (!(target instanceof HTMLElement)) return null
    if (target.classList.contains('toggle-code-btn')) return target
    return target.closest('.toggle-code-btn')
  }

  function handleToggleClick(event: MouseEvent) {
    const button = getToggleButton(event.target)
    if (!button) return

    event.preventDefault()

    const codeBlock = button.closest<HTMLElement>('.code-block')
    if (!codeBlock) return

    const isExpanded = codeBlock.classList.toggle('code-block--expanded')
    button.setAttribute('aria-expanded', isExpanded ? 'true' : 'false')
    button.setAttribute('aria-label', isExpanded ? '收起代码' : '展开代码')
    button.setAttribute('title', isExpanded ? '收起代码' : '展开代码')

    updateCodeBlockToggleState()
  }

  function initialize() {
    if (initialized) return
    initialized = true
    document.addEventListener('click', handleCopyClick)
    document.addEventListener('click', handleToggleClick)
    document.addEventListener('swup:content:replace', updateCodeBlockToggleState)
    document.addEventListener('DOMContentLoaded', updateCodeBlockToggleState)
    window.addEventListener('load', updateCodeBlockToggleState)
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer)
      resizeTimer = window.setTimeout(updateCodeBlockToggleState, 120)
    })
    window.requestAnimationFrame(updateCodeBlockToggleState)
    window.setTimeout(updateCodeBlockToggleState, 50)
    window.setTimeout(updateCodeBlockToggleState, 250)
  }

  initialize()
</script>

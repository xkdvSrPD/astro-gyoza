<style>
  #site-toast-root {
    position: fixed;
    right: 1rem;
    bottom: 1.5rem;
    z-index: 80;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
    pointer-events: none;
  }

  .site-toast {
    min-width: 12rem;
    max-width: min(24rem, calc(100vw - 2rem));
    border: 1px solid rgb(var(--color-border-primary) / 0.7);
    border-radius: 0.875rem;
    background: rgb(var(--color-bg-primary) / 0.95);
    color: rgb(var(--color-text-primary));
    box-shadow: 0 18px 36px rgb(var(--color-bg-root) / 0.32);
    backdrop-filter: blur(18px);
    padding: 0.75rem 0.875rem;
    opacity: 0;
    transform: translateY(0.5rem);
    transition:
      opacity 0.18s ease,
      transform 0.18s ease;
  }

  .site-toast--visible {
    opacity: 1;
    transform: translateY(0);
  }

  .site-toast--success {
    border-color: rgb(var(--color-accent) / 0.4);
  }

  .site-toast--error {
    border-color: rgb(244 63 94 / 0.4);
  }

  .site-toast__message {
    font-size: 0.875rem;
    line-height: 1.4;
  }
</style>

<script>
  interface ToastDetail {
    message: string
    type?: 'success' | 'error'
  }

  interface ToastWindow extends Window {
    __toastBridgeInitialized?: boolean
  }

  const toastWindow = window as ToastWindow

  function ensureRoot() {
    let root = document.getElementById('site-toast-root')
    if (!root) {
      root = document.createElement('div')
      root.id = 'site-toast-root'
      document.body.appendChild(root)
    }

    return root
  }

  function showToast(detail: ToastDetail) {
    if (!detail?.message) return

    const root = ensureRoot()
    const toast = document.createElement('div')
    toast.className = `site-toast site-toast--${detail.type || 'success'}`

    const message = document.createElement('div')
    message.className = 'site-toast__message'
    message.textContent = detail.message
    toast.appendChild(message)
    root.appendChild(toast)

    requestAnimationFrame(() => {
      toast.classList.add('site-toast--visible')
    })

    window.setTimeout(() => {
      toast.classList.remove('site-toast--visible')
      window.setTimeout(() => {
        toast.remove()
        if (!root.childElementCount) {
          root.remove()
        }
      }, 180)
    }, 3000)
  }

  if (!toastWindow.__toastBridgeInitialized) {
    toastWindow.__toastBridgeInitialized = true
    window.addEventListener('app-toast', (event) => {
      showToast((event as CustomEvent<ToastDetail>).detail)
    })
  }
</script>

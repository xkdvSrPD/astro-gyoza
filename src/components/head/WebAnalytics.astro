---
import { analytics } from '@/config.json'

if (import.meta.env.DEV || !analytics.enable) {
  return
}

const umamiSrc = analytics.umami.websiteId
  ? `${analytics.umami.serverUrl || 'https://cloud.umami.is'}/script.js`
  : ''
---

{
  analytics.umami.websiteId && (
    <script is:inline defer src={umamiSrc} data-website-id={analytics.umami.websiteId} />
  )
}

{
  analytics.google.measurementId && (
    <>
      <script
        is:inline
        async
        src={`https://www.googletagmanager.com/gtag/js?id=${analytics.google.measurementId}`}
      />
      <script is:inline>
        {`
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', '${analytics.google.measurementId}');
        `}
      </script>
    </>
  )
}

{
  analytics.microsoftClarity.projectId && (
    <script is:inline>
      {`
        (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", "${analytics.microsoftClarity.projectId}");
      `}
    </script>
  )
}
